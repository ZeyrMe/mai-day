  "id": "zeyr.mai-day",
  "version": "0.2.0",
  "name": "麦的一天",
  "description": "为麦麦提供日常作息、日程安排与夜间安静控制",
  "author": {
    "name": "zeyr",
    "url": "https://github.com/zeyr"
  },
  "license": "MIT",
