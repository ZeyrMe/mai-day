# Generated from config_models.py; instance config.toml stays local.
show_advanced = false
enabled = true
preset = "worker"
volatility_level = "natural"
sleep_silence = true
good_morning_mode = "passive_hint"
good_night_mode = "passive_hint"
timezone = "Asia/Shanghai"
day_rollover_hour = 5
window_days = 3
hard_bedtime = "03:00"
forced_rest_hours = 8
micro_duration_minutes = 20
max_awake_hours = 24
delay_minutes = 15
engaged_minutes = 10
max_debt_minutes = 120
compensation_minutes = 30
wake_minutes = 15
greeting_window_minutes = 30
active_group_recent_minutes = 120
share_cooldown_minutes = 60
share_lease_seconds = 120
tick_seconds = 30
hint_chars = 25
micro_events = ["取快递", "下楼散步", "买杯饮料"]
extras = []
admins = []
targets = []
passive_observation_groups = []
anchor_template = "{title}{status}"
open_title = "自由安排"
sleepy_hint = "，准备睡了"
waking_hint = "，刚醒"
sleep_hint = "，休息中"
low_energy_hint = "，有点困"
greeting_instruction = "根据材料，用当前会话的人设自然说一句{kind}，不要列清单。"
event_template = "{kind}：{detail}"

[plugin]
config_version = "0.1.0"

